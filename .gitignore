# ============================================================
#  ARTIQ runtime state
# ============================================================
# Persistent dataset store -- live experimental values, regenerated by
# running ExperimentVariables. Not meaningful in version control.
dataset_db.pyon

# Last-used run ID counter, written by ARTIQ on each submission.
last_rid.pyon

# ============================================================
#  Experiment output data
# ============================================================
# HDF5 result files from every run. Excluded from version control because:
#   * regenerable by re-running experiments
#   * grow indefinitely as you run more experiments
#   * can be megabytes-to-gigabytes per file
# If you need to share specific data, attach as a release artifact or
# upload to a dedicated data store.
results/
analysis_results/

# Loose data files anywhere in the tree (defensive).
*.h5
*.hdf5
*.zarr/
*.csv

# Allow analysis notebooks to define small example fixtures explicitly.
# (Add to allowlist below if needed.)

# ============================================================
#  Python bytecode and caches
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ============================================================
#  Editor / IDE / OS junk
# ============================================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Jupyter checkpoints
.ipynb_checkpoints/

# ============================================================
#  Conda / venv environments
# ============================================================
.conda*/
venv/
.venv/
env/

# ============================================================
#  Local secrets / credentials (defensive)
# ============================================================
*.pem
*.key
credentials.json
.env
.env.local
